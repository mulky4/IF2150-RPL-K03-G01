# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.

# PostgreSQL lokal (docker compose up -d). Kalau pakai Neon, ganti dengan connection string branch Neon milikmu.
DATABASE_URL="postgresql://rekanbumi:rekanbumi@localhost:5432/rekanbumi?schema=public"

# Rahasia Better Auth, minimal 32 karakter acak. Contoh membuatnya: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL aplikasi (dipakai Better Auth untuk link verifikasi email)
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
